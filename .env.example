# Copy to .env (docker compose) or paste into Portainer's stack environment variables.

# Database password. Letters and digits only (it goes into a URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# --- signing in -------------------------------------------------------------------
# basic: one account, below. proxy: your reverse proxy (Authelia, Authentik,
# oauth2-proxy) signs people in and passes the user in a header. none: no sign-in.
SCENTRY_AUTH_MODE=basic
SCENTRY_ADMIN_USER=admin
SCENTRY_ADMIN_PASSWORD=
# proxy mode only: the header, and the addresses allowed to set it (JSON list of CIDRs).
#SCENTRY_PROXY_USER_HEADER=Remote-User
#SCENTRY_TRUSTED_PROXIES=["172.18.0.0/16"]

# Where the portal listens on the Docker host. Keep 127.0.0.1 behind a reverse proxy
# on the same host; 0.0.0.0 exposes it to your network over plain HTTP.
SCENTRY_BIND=127.0.0.1
SCENTRY_PORT=8080

# --- fetching code ----------------------------------------------------------------
# Tokens for private repositories, keyed by host; each is sent to its own host only.
# GitHub: a fine-grained token with read-only "Contents" on the repositories to scan.
#SCENTRY_GIT_TOKENS={"github.com":"github_pat_..."}
# A GitHub token with NO permissions, only to lift GitHub's API limit when checking
# Home Assistant integrations: 60 requests an hour without one, enough for a few
# integrations; 5,000 with one. Needed with the Home Assistant sync below. GitHub:
# Settings -> Developer settings -> Fine-grained tokens, "Public repositories", no
# permissions added.
#SCENTRY_PUBLIC_GITHUB_TOKEN=
# Extra hosts the runner may reach (self-hosted Gitea/GitLab, a package mirror).
# "host" = that host; ".domain" = it and its subdomains.
#SCENTRY_EXTRA_ALLOWED_DOMAINS=git.example.net
# The runner<->gateway network. Change both if this range is taken on your host.
#SCENTRY_EGRESS_SUBNET=172.30.255.0/28
#SCENTRY_EGRESS_IP=172.30.255.2

# --- Home Assistant (optional) ----------------------------------------------------
# Scan every integration and card the Marketplace (HACS) has installed, each new version
# after an update, and an offered update before you install it.
# URL: HA as seen from Docker. HA Container on this same host (network_mode: host):
# http://host.docker.internal:8123. Elsewhere: its LAN address, or https://... .
#SCENTRY_HASS_URL=http://host.docker.internal:8123
# A long-lived access token (HA: your profile -> Security). HA lists the Marketplace only
# for administrators, so the token must be an admin's: make a dedicated "Scentry" admin
# user for it. Scentry sends only the list and subscribe commands, fixed in code.
#SCENTRY_HASS_TOKEN=
# false for a self-signed certificate (or mount a CA and set SCENTRY_HASS_CA_FILE).
#SCENTRY_HASS_VERIFY_TLS=true
#SCENTRY_HASS_POLL_SECONDS=600
#SCENTRY_HASS_SCAN_INTERVAL_HOURS=168

# --- notifications (optional) -----------------------------------------------------
# Where to send them: Apprise URLs, separated by spaces or commas. Examples:
#   ntfy://ntfy.sh/your-random-topic        ntfys://user:pass@ntfy.example.net/topic
#   gotify://host.docker.internal:8070/<app token>
#   discord://<webhook id>/<webhook token>   tgram://<bot token>/<chat id>
#   mailtos://user:app-password@gmail.com    pover://<user key>@<app token>
#   json://host.docker.internal:8123/api/webhook/<id>   (a Home Assistant automation)
# All services: https://github.com/caronc/apprise/wiki
#SCENTRY_NOTIFY_URLS=
# An HA integration or card scoring under this is announced: 70 = "Very Sus" and
# "BORK BORK BORK" (Barkley: 90+ Good Boy, 70+ Kinda Sus, 40+ Very Sus).
#SCENTRY_NOTIFY_SCORE_BELOW=70
# My code: new findings at this severity or worse (critical, high, medium, low).
#SCENTRY_NOTIFY_MIN_SEVERITY=high
# true = also announce offered updates that look fine ("safe to install").
#SCENTRY_NOTIFY_CLEAN_UPDATES=false
#SCENTRY_NOTIFY_FAILURES=true
# The portal's address as you open it, for links in messages.
#SCENTRY_PUBLIC_URL=https://scentry.example.lan

# --- scanning ---------------------------------------------------------------------
#SCENTRY_DISABLED_SCANNERS=["bandit"]
#SCENTRY_SEMGREP_CONFIG=p/default
# true = honour .semgrepignore, nosemgrep/nosec comments and friends in the repository.
#SCENTRY_HONOR_REPO_IGNORES=false
#SCENTRY_RUNNER_MEMORY=4g
#SCENTRY_WORK_SIZE=1g
